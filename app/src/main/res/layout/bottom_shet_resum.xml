<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_behavior="@string/bottom_sheet_behavior"
    app:behavior_hideable="false"
    app:behavior_peekHeight="@dimen/peek_bottom_shet" >


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/rec_bottom"
        android:layout_height="200dp">
        <TextView
            android:layout_width="32dp"
            style="@style/DivisorCategoryStyle"
            android:background="#7F7359"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:layout_below="@id/list_summary"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/s"
            android:layout_margin="2dp"
            android:paddingTop="3dp"
            android:paddingRight="4dp"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:paddingBottom="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:padding="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Total de ventas"
                    android:fontFamily="@font/opensansregular"
                    android:textColor="@color/FishyLetraDark"
                    android:textSize="@dimen/general_text"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:id="@+id/sumSales"
                    android:fontFamily="@font/opensansregular"
                    android:textColor="@color/FishyLetraDark"
                    android:textSize="@dimen/general_text"
                    />


            </LinearLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:padding="2dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Total kg"
                    android:fontFamily="@font/opensansregular"
                    android:textColor="@color/FishyLetraDark"
                    android:textSize="@dimen/general_text"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:id="@+id/sumkg"

                    android:fontFamily="@font/opensansregular"
                    android:textColor="@color/FishyLetraDark"
                    android:textSize="@dimen/general_text"
                    />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:padding="2dp"
                android:visibility="gone"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Total recaudado"
                    android:fontFamily="@font/opensansregular"
                    android:textColor="@color/FishyLetraDark"
                    android:textSize="@dimen/general_text"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:id="@+id/sumDone"
                    android:textColor="@color/FishyLetraDark"
                    android:fontFamily="@font/opensansregular"

                    android:textSize="@dimen/general_text"
                    />


            </LinearLayout>



        </LinearLayout>
    </LinearLayout>
</LinearLayout>